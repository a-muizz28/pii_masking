# --- Python env ---
.venv/
.env
.python-version.local

# --- Large model binaries / checkpoints ---
*.gguf
*.bin
*.safetensors
*.pt
*.pth
models/**/checkpoint-*/
models/**/__pycache__/
models/llama/

# Keep small evaluator-facing smoke-test summary, ignore its heavy checkpoint files.
models/smoke_test_distilbert/*
!models/smoke_test_distilbert/smoke_test_results.json

# --- Large data artifacts ---
*.parquet
data/raw/*
!data/raw/.gitkeep
!data/raw/*.json
data/processed/*
!data/processed/
!data/processed/*.json
.kaggle/
data/processed/hf_dataset/
kaggle/dataset_upload/hf_dataset/

# --- Build / cache ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/

# --- Evaluator-facing artifacts ---
# Keep JSON summaries and model comparison outputs trackable. These files are
# small and are used by notebooks, reports, and the final evaluator review.
!results/**/*.json
!predictions/**/*.json
!reports/**/*.json
!kaggle/**/*.json
!models/**/*_result.json

# Keep prediction caches needed by Day 6 and Day 7 review.
!predictions/encoder/
!predictions/encoder/*.jsonl
!predictions/llm/
predictions/llm/*
!predictions/llm/raw_outputs.jsonl
!predictions/wikiann/
!predictions/wikiann/*.json
predictions/wikiann/*.log
predictions/wikiann/*.jsonl
!predictions/wikiann/llama_outputs.jsonl
predictions/llm/codex_*

# errors/ holds machine-generated annotation sheets. Track TSVs, ignore everything else.
errors/*
!errors/*.tsv

# Auto-generated report draft. It is not hand-edited and can be regenerated.
reports/report_draft.md
reports/pii_masking_report.md

# Kaggle helper scripts/configs are tracked; copied notebooks are generated by push scripts.
kaggle/encoder/03_encoder_training.ipynb
kaggle/llm/04_llm_inference.ipynb
kaggle/evaluation/05_evaluation_platform_specific.ipynb

# Keep evaluation artifacts under results/ and reports/figures/ tracked.

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
