# --- Python env ---
.venv/
.env
.python-version.local

# --- Large model binaries / checkpoints ---
*.gguf
*.bin
*.safetensors
*.pt
*.pth
models/**/checkpoint-*/
models/**/__pycache__/
models/llama/

# Keep small evaluator-facing smoke-test summary, ignore its heavy checkpoint files.
models/smoke_test_distilbert/*
!models/smoke_test_distilbert/smoke_test_results.json

# --- Large data artifacts (regenerable from scripts / Kaggle uploads) ---
*.parquet
data/raw/*
!data/raw/.gitkeep
data/processed/
.kaggle/
data/processed/hf_dataset/
kaggle/dataset_upload/hf_dataset/

# --- Build / cache ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/

# Keep final LLM prediction cache for evaluation; ignore regenerable encoder predictions.
# Encoder predictions (predictions/encoder/*.jsonl) are large and reproducible via
# 05_evaluate_all.py — they stay ignored.
predictions/*
!predictions/llm/
predictions/llm/*
!predictions/llm/raw_outputs.jsonl
predictions/llm/codex_*
predictions/bootstrap_results.json

# errors/ holds machine-generated annotation sheets — track TSVs, ignore everything else.
errors/*
!errors/*.tsv

# Auto-generated report draft — not hand-edited, regenerable from scripts.
reports/report_draft.md

# Kaggle helper scripts/configs are tracked; copied notebooks are generated by push scripts.
kaggle/encoder/03_encoder_training.ipynb
kaggle/llm/04_llm_inference.ipynb
kaggle/evaluation/05_evaluation_platform_specific.ipynb

# Keep evaluation artifacts under results/ and reports/figures/ tracked.

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
